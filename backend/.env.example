# =========================================================================
# FASTAPI BACKEND CONFIGURATION TEMPLATE
# =========================================================================

# Neon PostgreSQL connection string.
# Omit or leave empty to automatically run on local SQLite (kerala_civic.db)
DATABASE_URL=postgresql://username:password@neon-db-host.neon.tech/dbname?sslmode=require

# JWT Token Signing Secret (Required for production JWT verification)
JWT_SECRET=your-random-production-secure-key-phrase

# Next.js Frontend URL (for CORS validation and cookie verification)
CLIENT_URL=http://localhost:3000

# Cloudinary Credentials (Optional).
# Omit or leave empty to automatically fall back to local disk storage in /backend/uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth Client ID (Required for Google Sign Up & Sign In verification)
GOOGLE_CLIENT_ID=your_google_client_id_here
