# =========================================================================
# PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION - NAMMUDE KERALA
# =========================================================================

# ----------------- Frontend Config (Vercel) -----------------
# The production URL of your Render backend API service
NEXT_PUBLIC_API_URL=https://nammude-kerala-api.onrender.com

# ----------------- Backend Config (Render) -----------------
# Neon PostgreSQL database URL connection string
DATABASE_URL=postgresql://username:password@neon-db-host.neon.tech/dbname?sslmode=require

# Secure JWT Authentication secret key
JWT_SECRET=nammude-kerala-secret-key-wow-very-secure-2026

# The production URL of your Vercel frontend client
CLIENT_URL=https://nammude-kerala.vercel.app

# ----------------- Media Storage Config (Cloudinary) -----------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------- Google Sign In / Signup Config -----------------
# Google OAuth Client ID for token verification (Backend)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google OAuth Client ID for OAuth React components (Frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
